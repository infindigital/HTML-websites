# ============================================================
# Life Care Specialty Hospital — Apache config (Hostinger)
# ============================================================
Options -Indexes
# Homepage is the self-contained SPA (index.html). The PHP front controller
# (index.php) still handles clean-URL deep links and the styled 404.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Force HTTPS + www→non-www (enable after SSL is active) ---
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Let the admin area handle its own clean-URL routing (admin/.htaccess)
  RewriteRule ^admin(/.*)?$ - [L]

  # Serve real files/directories directly (assets, uploads, sitemap...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → front controller
  RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

# --- Protect sensitive files ---
<FilesMatch "^(config\.php|config\.example\.php|seed_data\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md|lock|json|log)$">
  Require all denied
</FilesMatch>

# Block PHP execution inside uploads
<IfModule mod_php.c>
  <Directory "uploads">
    php_admin_flag engine off
  </Directory>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Browser caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom error page → front controller (renders styled 404)
ErrorDocument 404 /index.php
