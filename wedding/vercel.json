{
  "rewrites": [
    { "source": "/imran-rashina", "destination": "https://imran-rashina.vercel.app/" },
    { "source": "/imran-rashina/:path*", "destination": "https://imran-rashina.vercel.app/:path*" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ]
}
